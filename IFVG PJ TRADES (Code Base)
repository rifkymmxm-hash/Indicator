    if tr.open and bar_index > tr.bar
        bool   L    = tr.long
        string side = L ? "Long" : "Short"
        if L ? low <= tr.curSL : high >= tr.curSL
            if not tr.beHit
                recordStat(tr, false)
            string res = tr.tp1Hit ? "🟢TP 1" : tr.beHit ? "🔹BE" : "🔴SL"
            tr.sig.set_tooltip(tr.tip + "\n\nResult: " + res)
            pushAlert(alSLIn, side + " Stop-Loss Hit @ " + fmt(tr.curSL))
