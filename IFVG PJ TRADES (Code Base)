recordStat(Trade t, bool win) =>
    int w = win ? 1 : 0
    statWin.set(t.rank, statWin.get(t.rank) + w)
    statTot.set(t.rank, statTot.get(t.rank) + 1)
    int d = t.long ? 3 : 4
    statWin.set(d, statWin.get(d) + w)
    statTot.set(d, statTot.get(d) + 1)

winRate(int i) =>
    int t = statTot.get(i)
    t > 0 ? str.tostring(statWin.get(i) * 100.0 / t, "#.##") + "%" : "-"

