fireSignal(bool long, Setup st, Fvg f, float sl, float be, float tp1, float tp2, int rank) =>
    string rating = rank == 2 ? "A++" : rank == 1 ? "A+" : "A"
    color  col    = long ? longCol : shortCol
    string tip    = "Setup Rating: " + rating + "\nDirection: " + (long ? "Long" : "Short") + "\nLiquidity Swept: " + st.names + "\nMulti-Liquidity Sweep: " + (st.count >= 2 ? "Yes" : "No") + "\nHTF FVG Tap: " + (st.tap ? "Yes (" + st.tapTf + ")" : "No") + "\nInside Macro: " + (inMacro ? "Yes" : "No") + "\n\nEntry: " + fmt(close) + "\nSL: " + fmt(sl) + "\nBE: " + fmt(be) + "\nTP 1: " + fmt(tp1) + "\nTP 2: " + fmt(tp2)
    label sig = label.new(bar_index, long ? low : high, rating, style = long ? label.style_label_up : label.style_label_down, color = col, textcolor = long ? longTxtCol : shortTxtCol, size = txtSize(long ? longSizeIn : shortSizeIn), tooltip = tip)
    sigLabels.push(sig)
    while sigLabels.size() > MAX_SIG
        label.delete(sigLabels.shift())
    Trade t = Trade.new(long = long, bar = bar_index, rating = rating, rank = rank, entry = close, sl = sl, be = be, tp1 = tp1, tp2 = tp2, curSL = sl, tip = tip, sig = sig)
    if entryLnIn
        t.lE := mkLine(close, entryCol)
        t.bE := mkLbl(lvlText("Entry", close, close, entryPxIn, false), close, entryCol)
    if slLnIn
        t.lS := mkLine(sl, slCol)
        t.bS := mkLbl(lvlText("SL", sl, close, slPxIn, false), sl, slCol)
    if beLnIn
        t.lB := mkLine(be, beCol)
        t.bB := mkLbl(lvlText("BE", be, close, bePxIn, false), be, beCol)
    if tpLnIn
        t.l1 := mkLine(tp1, tp1Col)
        t.b1 := mkLbl(lvlText("TP 1", tp1, close, tpPxIn, false), tp1, tp1Col)
        t.l2 := mkLine(tp2, tp2Col)
        t.b2 := mkLbl(lvlText("TP 2", tp2, close, tpPxIn, false), tp2, tp2Col)
    if ifShowIn
        color ic = long ? ifBullCol : ifBearCol
        ifvgBoxes.push(box.new(f.bar - 1, f.top, bar_index, f.bot, border_color = color.new(ic, 40), bgcolor = ic))
        if ifMidIn
            ifvgMids.push(line.new(f.bar - 1, (f.top + f.bot) / 2, bar_index, (f.top + f.bot) / 2, color = ifMidCol, style = lineStyle(ifMidStyle)))
        while ifvgBoxes.size() > MAX_IFVG
            box.delete(ifvgBoxes.shift())
        while ifvgMids.size() > MAX_IFVG
            line.delete(ifvgMids.shift())
    pushAlert(long ? alLongIn : alShortIn, (long ? "Long" : "Short") + " Signal (" + rating + ") | Entry " + fmt(close) + " | SL " + fmt(sl) + " | BE " + fmt(be) + " | TP1 " + fmt(tp1) + " | TP2 " + fmt(tp2))
    t

evalSetup(bool long, Setup st) =>
    Trade out = na
    bool  ifvg = false
    Fvg f = findIfvg(long ? bearFvgs : bullFvgs, long, st.legStart, st.extBar)
    if not na(f)
        ifvg := true
        [sl, be, tp1, tp2] = tradeLevels(long, close, st.ext)
        float risk = math.abs(close - sl)
        float rr   = risk > 0 ? math.abs(tp2 - close) / risk : 0.0
        int   conf = (st.tap ? 1 : 0) + (st.count >= 2 ? 1 : 0) + (inMacro ? 1 : 0)
        int   rank = math.min(conf, 2)
        bool  dirOk = long ? (allowLong and showLongIn) : (allowShort and showShortIn)
        bool  slOk  = long ? sl < close : sl > close
        if dirOk and inWindow and (not useMacroIn or inMacro) and risk > 0 and slOk and rr >= minRRIn and rank >= minRank
            out := fireSignal(long, st, f, sl, be, tp1, tp2, rank)
    [out, ifvg]

