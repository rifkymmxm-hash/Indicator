tradeLevels(bool long, float entry, float ext) =>
    float sl = na
    array<float> tg = array.new<float>()
    for lv in (long ? liqLows : liqHighs)
        if lv.kind == 0 and not lv.swept and (long ? lv.price < entry : lv.price > entry)
            sl := na(sl) ? lv.price : long ? math.max(sl, lv.price) : math.min(sl, lv.price)
    for lv in (long ? liqHighs : liqLows)
        if lv.kind == 0 and not lv.swept and (long ? lv.price > entry : lv.price < entry)
            tg.push(lv.price)
    tg.sort(long ? order.ascending : order.descending)
    if na(sl)
        sl := ext
    array<float> t = array.new<float>()
    for p in tg
        if t.size() == 0 or p != t.last()
            t.push(p)
        if t.size() == 3
            break
    float risk = math.abs(entry - sl)
    float dir  = long ? 1.0 : -1.0
    float be   = t.size() > 0 ? t.get(0) : entry + dir * risk
    float tp1  = t.size() > 1 ? t.get(1) : entry + dir * 2 * risk
    float tp2  = t.size() > 2 ? t.get(2) : entry + dir * 3 * risk
    [sl, be, tp1, tp2]

